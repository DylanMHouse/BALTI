/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests from fastq input
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same as the test profile, but runs the 'test' tumour/germline pair from fastq.gz.
    The fastqs in tests/data/fastq/ are `samtools fastq -T '*'` conversions of the
    nf-core COLO829 / COLO829BL BAMs, as nf-core/test-datasets has no COLO829 fastq.

    Use as follows:
        nextflow run nf-core/balti -profile test_fastq,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

includeConfig 'test.config'

params {
    config_profile_name        = 'Test profile (fastq)'

    input      = "${projectDir}/tests/data/samplesheet_test_fastq.csv"
    input_type = 'fastq'
}
