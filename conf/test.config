/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    Runs one tumour/germline pair ('test') from BAM input: the COLO829 / COLO829BL
    ONT chr22 subsets and hg38 chr22 reference from nf-core/test-datasets (modules branch).

    Use as follows:
        nextflow run nf-core/balti -profile test,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '12.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input           = "${projectDir}/tests/data/samplesheet_test.csv"
    input_type      = 'bam'

	// Clair3
	clair3_model      = 'r1041_e82_400bps_sup_v500'
	clair3_home_model = null

    // Genome references
    fasta           = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/chr22/sequence/hg38.chr22.fasta'
    genome          = null
    igenomes_ignore = true

    // Workflow toggles
    qc              = true
    coverage        = true
	minimap2		= true
	clair3			= true
    cnvpytor        = false
    strbed          = "${projectDir}/tests/data/strdust_chr22.bed"
}
