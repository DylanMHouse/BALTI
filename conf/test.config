/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    Runs one tumour/germline pair ('test') from unaligned BAM input.

    Use as follows:
        nextflow run nf-core/balti -profile test,<docker/singularity> --outdir <OUTDIR>

    Expects the small test data in tests/data/ (see tests/data/samplesheet_test.csv).
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input           = "${projectDir}/tests/data/samplesheet_test.csv"
    input_type      = 'bam'

    // Genome references
    fasta           = "${projectDir}/tests/data/ref/test.fa"
    genome          = null
    igenomes_ignore = true

    // Workflow toggles
    qc              = true
    coverage        = true
}
