/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        // Per-sample outputs go to ${outdir}/Tumour/<tool> or ${outdir}/Germline/<tool>; shared outputs (reference, MultiQC) to ${outdir}/<tool>
        path: { "${params.outdir}/${meta?.type ? meta.type.capitalize() + '/' : ''}${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }
    withName: SAMTOOLS_FASTQ {
    	ext.args = '-T MM,ML'
	cpus = 32
    }
    withName: SAMTOOLS_CAT {
    	cpus = 32
    }
    withName: MINIMAP2_ALIGN {
    	ext.args = '--MD -Y -ax lr:hq -y'
	cpus = 32
    }
    withName: PARABRICKS_MINIMAP2 {
    	ext.args = '--chaining-on-gpu --gpusort --gpuwrite --preset lr:hq'
	cpus = 32
    }
	withName: CLAIR3 { ext.prefix = { "${meta.id}_" } }

    // Spectre bins must match these mosdepth windows; prefix keeps them apart from the coverage MOSDEPTH outputs
    withName: MOSDEPTH_SPECTRE {
        ext.args   = '--by 1000 --no-per-base'
        ext.prefix = { "${meta.id}.cnv_bins" }
    }

    withName: LONGPHASE_MODCALL {
        ext.prefix = { "${meta.id}_modcall" }
    }
    // Input SV VCF from Sniffles is already named ${meta.id}.vcf.gz
    withName: LONGPHASE_PHASE {
        ext.args   = '--ont'
        ext.prefix = { "${meta.id}.phased" }
    }
    // Input BAM from minimap2 is already named ${meta.id}.bam
    withName: LONGPHASE_HAPLOTAG {
        ext.prefix = { "${meta.id}.haplotagged" }
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
