nextflow_process {

    name "Test Process SPECTRE_CNVCALLER"
    script "../main.nf"
    process "SPECTRE_CNVCALLER"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "spectre"
    tag "spectre/cnvcaller"
    tag "mosdepth"
    tag "clair3"

    // COLO829 ONT R10.4.1 Dorado sup BAM, subset to chr22:24-25Mb. Coverage is far too low to call CNVs,
    // so this checks that Spectre runs end to end on real binned coverage and SNV calls
    setup {
        run("MOSDEPTH") {
            script "../../../../nf-core/mosdepth/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/savana/colo829.PAU61426.sup.chr22.subset.0.05.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/savana/colo829.PAU61426.sup.chr22.subset.0.05.bam.bai', checkIfExists: true),
                    []
                ]
                input[1] = [ [:], [] ]
                input[2] = []
                """
            }
        }
        run("CLAIR3") {
            script "../../../../nf-core/clair3/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/savana/colo829.PAU61426.sup.chr22.subset.0.05.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/nanopore/bam/savana/colo829.PAU61426.sup.chr22.subset.0.05.bam.bai', checkIfExists: true),
                    'r1041_e82_400bps_sup_v500',
                    [],
                    'ont'
                ]
                input[1] = [
                    [ id:'hg38_chr22' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr22/sequence/hg38.chr22.fasta', checkIfExists: true)
                ]
                input[2] = [
                    [ id:'hg38_chr22' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr22/sequence/hg38.chr22.fasta.fai', checkIfExists: true)
                ]
                """
            }
        }
    }

    test("homo_sapiens - ont - mosdepth, clair3 vcf - fasta") {

        when {
            process {
                """
                input[0] = MOSDEPTH.out.summary_txt
                    .join(MOSDEPTH.out.regions_bed)
                    .join(MOSDEPTH.out.regions_csi)
                    .join(CLAIR3.out.vcf)
                input[1] = [
                    [ id:'hg38_chr22' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr22/sequence/hg38.chr22.fasta', checkIfExists: true)
                ]
                input[2] = []
                input[3] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("homo_sapiens - ont - mosdepth, clair3 vcf - fasta - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = MOSDEPTH.out.summary_txt
                    .join(MOSDEPTH.out.regions_bed)
                    .join(MOSDEPTH.out.regions_csi)
                    .join(CLAIR3.out.vcf)
                input[1] = [
                    [ id:'hg38_chr22' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr22/sequence/hg38.chr22.fasta', checkIfExists: true)
                ]
                input[2] = []
                input[3] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
