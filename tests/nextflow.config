/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/balti/'
}

// Keep tests within a laptop's resources even when the test profile is not applied (e.g. --profile docker)
process {
    resourceLimits = [
        cpus: 4,
        memory: '12.GB',
        time: '1.h'
    ]
}

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true
